# Telegram
BOT_TOKEN=123456:replace-with-token-from-BotFather
# Your numeric Telegram user ID(s), comma separated. Only these users can use the bot.
ALLOWED_USER_IDS=123456789

# Folder with terminal64.exe and MetaEditor64.exe (a dedicated copy of MT5, run in portable mode)
TERMINAL_DIR=C:\MT5_Backtest

# Optional: account the tester runs under. Only needed if the tester log says
# "account is not specified". Use a DEMO account. The password is optional if the terminal
# already saved it; if set, the bot deletes the temporary tester config after each run.
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=

# Optional: copy your custom .mqh files / libraries / indicators from your everyday terminal
# into the backtest terminal before every compile. Point this at that terminal's MQL5 folder
# (in that terminal: File > Open Data Folder, then the MQL5 folder inside it).
SYNC_SOURCE_MQL5=C:\Users\Administrator\AppData\Roaming\MetaQuotes\Terminal\04C7A32B575E40027B4FF8724D14D702\MQL5
# Subfolder of MQL5\Experts that holds your .mqh files (used for #include "file.mqh")
SYNC_EXPERTS_SUBDIR=Advisors

# Where the bot keeps ini files and compile logs
WORK_DIR=work

# Timeouts
COMPILE_TIMEOUT_S=180
TEST_TIMEOUT_MIN=360

# Default tester settings (overridable per upload)
DEFAULT_SYMBOL=XAUUSD
DEFAULT_PERIOD=H1
DEFAULT_MODEL=1
DEFAULT_FROM=2025.01.01
DEFAULT_TO=2025.10.01
DEFAULT_DEPOSIT=10000
DEFAULT_CURRENCY=USD
DEFAULT_LEVERAGE=100
